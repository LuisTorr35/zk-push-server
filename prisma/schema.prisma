// Database schema. Every change here goes through `prisma migrate dev`, which
// records it as a versioned migration in prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Device {
  id             Int             @id @default(autoincrement())
  sn             String          @unique
  name           String
  enabled        Boolean         @default(true)
  model          String?
  firmware       String?
  ip             String?
  lastSeenAt     DateTime?       @db.Timestamptz(3)
  userCount      Int?
  faceCount      Int?
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)
  attendanceLogs AttendanceLog[]
  commands       Command[]
}

model AttendanceLog {
  id         Int      @id @default(autoincrement())
  deviceId   Int
  device     Device   @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  pin        String
  localTime  DateTime // Terminal Time
  status     Int
  verifyType Int
  raw        String
  receivedAt DateTime @default(now())

  @@unique([deviceId, pin, localTime])
  @@index([deviceId, localTime])
  @@index([pin])
}

enum CommandStatus {
  pending
  sent
  confirmed
  failed
}

model Command {
  id              Int              @id @default(autoincrement())
  deviceId        Int
  device          Device           @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  type            String
  payload         String?
  personId        Int?
  person          Person?          @relation(fields: [personId], references: [id], onDelete: Restrict)
  photoId         String?
  photo           Photo?           @relation(fields: [photoId], references: [id], onDelete: Restrict)
  operationId     String?
  operation       PersonOperation? @relation(fields: [operationId], references: [id], onDelete: Restrict)
  predecessorId   Int?
  predecessor     Command?         @relation("CommandDependency", fields: [predecessorId], references: [id], onDelete: Restrict)
  dependents      Command[]        @relation("CommandDependency")
  dependencyMode  String?
  profileSnapshot Json?
  failureReason   String?
  status          CommandStatus    @default(pending)
  priority        Int              @default(0)
  attempts        Int              @default(0)
  maxAttempts     Int              @default(5)
  dedupeKey       String?
  returnCode      Int?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  sentAt          DateTime?        @db.Timestamptz(3)
  respondedAt     DateTime?        @db.Timestamptz(3)
  deliveries      CommandAttempt[]

  @@index([deviceId, status, priority(sort: Desc), createdAt, id])
  @@index([personId, deviceId, status])
  @@index([operationId])
}

enum PhotoStorageMode {
  both
  s3
  db
}

model Person {
  id         Int               @id @default(autoincrement())
  pin        String            @unique
  name       String
  externalId String?
  version    Int               @default(1)
  photoId    String?
  photo      Photo?            @relation("CurrentPhoto", fields: [photoId], references: [id], onDelete: Restrict)
  createdAt  DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime          @updatedAt @db.Timestamptz(3)
  operations PersonOperation[]
  commands   Command[]
}

model Photo {
  id          String           @id
  mode        PhotoStorageMode
  s3Bucket    String?
  s3Key       String?
  bytes       Bytes?
  contentType String
  size        Int
  hash        String
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  persons     Person[]         @relation("CurrentPhoto")
  commands    Command[]
}

model PersonOperation {
  id        String    @id @default(uuid())
  personId  Int
  person    Person    @relation(fields: [personId], references: [id], onDelete: Restrict)
  action    String
  version   Int
  deviceSns String[]
  createdAt DateTime  @default(now()) @db.Timestamptz(3)
  commands  Command[]

  @@index([personId, createdAt])
}

model CommandAttempt {
  id          Int       @id @default(autoincrement())
  commandId   Int
  command     Command   @relation(fields: [commandId], references: [id], onDelete: Restrict)
  number      Int
  sentAt      DateTime  @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  respondedAt DateTime? @db.Timestamptz(3)
  returnCode  Int?

  @@unique([commandId, number])
}

// Serialized events remain independent of source rows and survive failed delivery.
enum WebhookStatus {
  pending
  sending
  delivered
  failed
}

model WebhookDelivery {
  id            String        @id @default(uuid())
  sourceKey     String        @unique
  type          String
  body          String
  status        WebhookStatus @default(pending)
  attempts      Int           @default(0)
  maxAttempts   Int
  nextAttemptAt DateTime      @default(now()) @db.Timestamptz(3)
  lockToken     String?
  lockedUntil   DateTime?     @db.Timestamptz(3)
  lastHttpCode  Int?
  lastError     String?
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @db.Timestamptz(3)
  deliveredAt   DateTime?     @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([status, lockedUntil])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
