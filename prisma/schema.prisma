// Database schema. Every change here goes through `prisma migrate dev`, which
// records it as a versioned migration in prisma/migrations/.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AttendanceLog {
  id         Int      @id @default(autoincrement())
  deviceSn   String
  pin        String
  localTime  DateTime // Terminal Time
  status     Int
  verifyType Int
  raw        String
  receivedAt DateTime @default(now())

  @@unique([deviceSn, pin, localTime])
  @@index([pin])
}
