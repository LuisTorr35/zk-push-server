# Runtime
NODE_ENV=development
PORT=3000
COMMAND_ACK_TIMEOUT_SECONDS=60

# Database
DATABASE_URL=postgresql://zk:zk@localhost:5433/zk_push?schema=public

# API clients send this value in X-API-Key; iclock remains open to terminals.
API_KEY=replace-with-a-random-secret

# Photos: 0 = both, 1 = S3 (default), 2 = database.
PHOTO_STORAGE=1

# Required for modes 0 and 1. Docker uses http://minio:9000 internally.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=zk-photos
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Outgoing events. Both empty disables creation and pauses pending deliveries.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_POLL_INTERVAL_MS=1000
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=10
