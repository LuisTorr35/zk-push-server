# Runtime
NODE_ENV=development
PORT=3000

# Database
DATABASE_URL=postgresql://zk:zk@localhost:5433/zk_push?schema=public

# Photos: "db" stores them in the database, "s3" in a bucket (MinIO, R2, AWS)
PHOTO_STORAGE=db

# Only required when PHOTO_STORAGE=s3
# S3_ENDPOINT=http://localhost:9000
# S3_BUCKET=zk-photos
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin
